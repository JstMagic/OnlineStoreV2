PORT=8080
ALLOWED_ORIGINS=http://localhost:8080
DATABASE_URL=postgres://user:pass@localhost:5432/app
# Use verified TLS for Postgres. For a trusted local-only database without TLS,
# PGSSLMODE=disable is allowed outside production only.
PGSSLMODE=verify-full

# Optional custom CA certificate path used when PGSSLMODE=verify-full.
# PGSSLROOTCERT=/path/to/ca-certificate.crt
